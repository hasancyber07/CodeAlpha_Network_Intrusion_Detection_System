# --------------------------------------------------
# CodeAlpha Cybersecurity Internship - Task 4
# Custom Snort 3 Rules for NIDS
# --------------------------------------------------

# 1. Detect ICMP Ping Traffic
alert icmp any any -> any any (msg:"[DIQQET] ICMP Ping Trafiki Ashkar Edildi!"; sid:1000001; rev:1;)

# 2. Detect Nmap SYN Port Scan
alert tcp any any -> any any (msg:"[DIQQET] Nmap Port Skani Cehdi!"; flags:S; sid:1000002; rev:1;)

# 3. Detect Suspicious HTTP Admin Access Attempt
alert tcp any any -> any 80 (msg:"[DIQQET] Subheli Web Sorğu: /admin!"; content:"/admin"; sid:1000003; rev:1;)
